{
  "name": "season-ticket",
  "version": "1.0.0",
  "private": true,
  "description": "Season Ticket: a soccer club owner/GM sim with a live tactics match engine, by Longlight Interactive.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "check:first-load": "node scripts/check-first-load.mjs",
    "test": "vitest run --project unit",
    "test:perf": "vitest run --project perf",
    "test:slow": "vitest run --project slow",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sim": "vitest run tests/season.test.ts",
    "golden": "UPDATE_GOLDEN=1 vitest run --project unit tests/golden.test.ts",
    "credits": "UPDATE_CREDITS=1 vitest run --project unit tests/credits.test.ts"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "meshoptimizer": "1.1.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
